# Local development database. Change the password for your own environment.
POSTGRES_DB=sunpower
POSTGRES_USER=sunpower
POSTGRES_PASSWORD=local-dev-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set a random secret in .env before starting the API.
JWT_SECRET=
SECURE_COOKIES=false
FRONTEND_ORIGIN=http://localhost:5173
API_PROXY_TARGET=http://127.0.0.1:8000
ADVANCE_PERCENT=30
